---
// A table with a client-side text filter. Everything is rendered server-side,
// so the full contents are in the HTML for Pagefind to index and for anyone
// with JS disabled — the filter only hides rows that are already there.
const { columns, rows, placeholder = '輸入關鍵字篩選…', caption } = Astro.props;
const id = `ft-${Math.abs(JSON.stringify(columns).split('').reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}-${rows.length}`;
---

<div class="filter-table" data-filter-table={id}>
  <label class="filter-table__search">
    <input type="search" placeholder={placeholder} aria-label={placeholder} />
    <span class="filter-table__count" data-total={rows.length}>{rows.length} 筆</span>
  </label>

  <div class="filter-table__scroll">
    <table>
      {caption && <caption>{caption}</caption>}
      <thead>
        <tr>
          {columns.map((col) => (
            <th scope="col" style={col.align ? `text-align:${col.align}` : undefined}>{col.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {columns.map((col) => (
              <td style={col.align ? `text-align:${col.align}` : undefined}>
                {col.key === 'name' ? <strong>{row[col.key]}</strong> : row[col.key]}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .filter-table { margin: 1rem 0 1.5rem; }
  .filter-table__search {
    display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;
  }
  .filter-table__search input {
    flex: 1; padding: 0.4rem 0.7rem; font: inherit; font-size: 0.9rem;
    color: var(--sl-color-white);
    background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
  }
  .filter-table__search input:focus-visible {
    outline: 2px solid var(--sl-color-accent); outline-offset: -1px;
  }
  .filter-table__count {
    font-size: 0.8rem; color: var(--sl-color-gray-3); white-space: nowrap;
  }
  .filter-table__scroll { overflow-x: auto; }
  .filter-table table { margin: 0; font-size: 0.875rem; width: 100%; }
  .filter-table th { white-space: nowrap; }
  .filter-table td { vertical-align: top; }
  .filter-table tr[hidden] { display: none; }
</style>

<script>
  document.querySelectorAll('[data-filter-table]').forEach((root) => {
    const input = root.querySelector('input');
    const count = root.querySelector('.filter-table__count');
    const rows = Array.from(root.querySelectorAll('tbody tr'));
    const total = Number(count.dataset.total);
    const haystacks = rows.map((r) => r.textContent.toLowerCase());

    input.addEventListener('input', () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      rows.forEach((row, i) => {
        const match = terms.every((t) => haystacks[i].includes(t));
        row.hidden = !match;
        if (match) shown++;
      });
      count.textContent = shown === total ? `${total} 筆` : `${shown} / ${total} 筆`;
    });
  });
</script>
