<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: launchd needs literal absolute paths (no $HOME/env expansion),
  so substitute /path/to/openmmo-agent-wiki below with this checkout's actual
  absolute path before `launchctl load`ing this file, e.g.:
    sed "s#/path/to/openmmo-agent-wiki#$(pwd)#g" scripts/to.nexus.openmmo-wiki-sync.plist \
      > ~/Library/LaunchAgents/to.nexus.openmmo-wiki-sync.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>to.nexus.openmmo-wiki-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/openmmo-agent-wiki/scripts/wiki-sync-cron.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>17</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/path/to/openmmo-agent-wiki/.wiki-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/openmmo-agent-wiki/.wiki-sync.log</string>
</dict>
</plist>
